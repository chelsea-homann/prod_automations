# ============================================================
#  Environment Variables for HR Survey Automations
# ============================================================
#  Copy this file to config.env and fill in your values.
#  Load with: source config.env (Linux/Mac) or use a .bat SET wrapper (Windows).
#  NEVER commit the filled-in config.env to version control.
# ============================================================

# ---- HRIS API Credentials ----
export WD_USERNAME="your_HRIS_username"
export WD_PASSWORD="your_HRIS_password"

# ---- HRIS Report URLs ----
# Use {start_dt} and {end_dt} as placeholders for date parameters.
# Example: https://myHRIS.com/customreport/tenant/report?Start={start_dt}&End={end_dt}&format=csv

export WD_REPORT_URL=""           # Exit survey terminated workers report
export WD_LEAVE_REPORT_URL=""     # Leave-return report
export WD_SAAS_REPORT_URL=""      # SAAS employee roster report
export WD_TERM_REPORT_URL=""      # Daily terminated workers report
export WD_EMPLOYEE_REPORT_URL=""  # Daily active employee report
export WD_HIRE_REPORT_URL=""      # LDP hires report
export WD_JOBCHANGE_REPORT_URL="" # LDP job changes report

# ---- SFTP Configuration ----
export SFTP_HOST="sftp.example.com"
export SFTP_USER="your_sftp_username"
export SFTP_PASSWORD="your_sftp_password"
export SFTP_REMOTE_DIR="/Home/account/Out/"

# ---- Email / SMTP Configuration ----
export SMTP_HOST="mail.example.com"
export SMTP_PORT="25"
export EMAIL_SENDER="noreply@example.com"
export EMAIL_RECIPIENTS="user1@example.com,user2@example.com"

# ---- SAAS API (for SAAS_survey_export.py) ----
export SAAS_API_TOKEN="your_SAAS_api_token"
export SAAS_SURVEY_ID="SV_xxxxxxxxxxxxxxxxx"
export SAAS_DATACENTER="your_datacenter_id"
export SAAS_FORMAT="csv"

# ---- Optional Proxy (for corporate networks) ----
# export PROXY_HTTP="http://proxy.example.com:8080"
# export PROXY_HTTPS="http://proxy.example.com:8080"

# ---- Output Configuration ----
export OUTPUT_FILENAME="exit_survey_participants.csv"
export OUTPUT_DIR="./output"
export OUTPUT_PREFIX="survey_export"

# ---- Date Range Configuration ----
export LOOKBACK_DAYS="4"
export LOOKFORWARD_DAYS="0"

# ---- Conda Environment (for run_automation.bat) ----
export CONDA_PATH="C:/ProgramData/Miniconda3"
export CONDA_ENV="py37"

# ---- LDP Candidate Reports (JSON array for ldp_HRIS_monthly_pull.py) ----
# export WD_CANDIDATE_URLS='[{"name":"Program A","url":"https://...","output":"candidates_a.csv"}]'
